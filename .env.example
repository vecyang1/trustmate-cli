# TrustMate CLI Environment Configuration Example

# TrustMate Web Panel Session Cookie (Required for Direct REST API mode)
# You can extract this from Chrome DevTools Application -> Cookies for https://trustmate.io
TRUSTMATE_COOKIE="user_session=your_session_cookie_here"

# Optional: CSRF Token
TRUSTMATE_CSRF_TOKEN=""

# Optional: Custom API Base URL (Defaults to https://trustmate.io)
TRUSTMATE_BASE_URL="https://trustmate.io"
